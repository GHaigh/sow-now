[Unit]
Description=Sow Now Pi Agent — sensor data collector and uplink
After=network-online.target
Wants=network-online.target
# Start after portal and provision if they exist, but don't hard-require them —
# on already-provisioned devices these services may not be present.
After=sow-now-portal.service sow-now-provision.service
Wants=sow-now-provision.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=sownow
Group=sownow
WorkingDirectory=/opt/sow-now-agent

ExecStart=/opt/sow-now-agent/venv/bin/python3 -m agent.main

# Restart automatically on any non-zero exit
Restart=on-failure
RestartSec=10

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/sow-now
ReadWritePaths=/etc/sow-now
PrivateTmp=true
PrivateDevices=false

Environment=PYTHONUNBUFFERED=1
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sow-now-agent

[Install]
WantedBy=multi-user.target
