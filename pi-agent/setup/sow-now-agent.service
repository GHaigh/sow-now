[Unit]
Description=Sow Now Pi Agent — sensor data collector and uplink
After=network-online.target
Wants=network-online.target
# Don't start until portal has exited (WiFi configured) and JWT is provisioned
After=sow-now-portal.service sow-now-provision.service
Requires=sow-now-provision.service

[Service]
Type=simple
User=sownow
Group=sownow
WorkingDirectory=/opt/sow-now-agent

ExecStart=/opt/sow-now-agent/venv/bin/python3 -m agent.main

# Restart automatically on any non-zero exit
Restart=on-failure
RestartSec=10
StartLimitIntervalSec=60
StartLimitBurst=5

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/sow-now
ReadWritePaths=/etc/sow-now
PrivateTmp=true
PrivateDevices=false   # false — needs access to USB RTL-SDR device

Environment=PYTHONUNBUFFERED=1
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sow-now-agent

[Install]
WantedBy=multi-user.target
