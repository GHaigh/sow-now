{
  "name": "vernal",
  "version": "0.1.0",
  "private": true,
  "description": "Precision GDD platform for home growers",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=apps/api\" \"npm run dev --workspace=apps/web\"",
    "build": "npm run build --workspace=apps/api && npm run build --workspace=apps/web",
    "deploy": "npm run deploy --workspace=apps/api && npm run deploy --workspace=apps/web",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:migrate:local": "wrangler d1 migrations apply vernal-db --local",
    "db:migrate": "wrangler d1 migrations apply vernal-db --remote",
    "db:seed:local": "wrangler d1 execute vernal-db --local --file=./scripts/seed.sql",
    "cf:setup": "node ./scripts/cf-setup.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "wrangler": "^4.20.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
